{
  "name": "moonpaw-chibi-roller",
  "version": "0.2.1",
  "private": true,
  "description": "A dark pixel horror pilgrimage through ten dangerous thresholds.",
  "author": "Adnan Naous",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/offline.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "desktop": "pnpm build && electron .",
    "desktop:pack": "pnpm build && electron-builder --win --dir",
    "desktop:release": "pnpm build && electron-builder --win portable",
    "mobile:sync": "pnpm build && cap sync",
    "android": "cap open android",
    "ios": "cap open ios",
    "test:browser": "playwright test",
    "test:app": "node scripts/app-smoke.cjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@playwright/test": "^1.58.0",
    "@types/three": "^0.186.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^4.0.0"
  },
  "build": {
    "compression": "store",
    "electronDist": "node_modules/electron/dist",
    "appId": "com.adnannaous.moonpaw",
    "productName": "MOONPAW Ashen Vow",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "MOONPAW-Ashen-Vow-${version}-Windows.exe"
    }
  }
}
